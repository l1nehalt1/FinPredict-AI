DB_SERVER=.\SQLEXPRESS
DB_DATABASE=FinPredictAI_Demo
DB_USERNAME=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes
DB_ENCRYPT=yes
DB_TIMEOUT=10
# Для доступа только по HTTPS: yes. Для локального HTTP: no.
FINPREDICT_COOKIE_SECURE=no
# Можно задать свой случайный ключ. Иначе сохраняется локально в .session-secret.
# FINPREDICT_SECRET_KEY=

# Первый запуск импортирует 1000 клиентов; пароли запрашиваются в терминале.
FINPREDICT_BOOTSTRAP_DEMO=yes
FINPREDICT_ADMIN_EMAIL=admin@finpredict.local
# Для автоматического запуска можно задать секреты локально (не отправляйте .env):
# FINPREDICT_ADMIN_PASSWORD=
# FINPREDICT_DEMO_PASSWORD=
